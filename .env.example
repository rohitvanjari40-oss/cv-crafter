# Database connection (PostgreSQL by default, or SQLite for instant local dev)
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/cvcrafter?schema=public
# For SQLite (instant zero-dependency dev): file:./dev.db
DATABASE_URL="file:./dev.db"

# JWT Secret for user session tokens
JWT_SECRET="cvcrafter-super-secret-jwt-key-for-bca-college-project-2026"

# Google Gemini API Key (Optional: for AI Summary, Bullet Polish, and deep Job Matching)
# Get a free key at: https://aistudio.google.com/
# If omitted, CV Crafter automatically uses its built-in algorithmic engine!
GEMINI_API_KEY=""

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
